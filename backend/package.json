{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "seed:demo": "node --env-file-if-exists=.env prisma/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.2.1",
    "jose": "^6.2.17",
    "nodemailer": "^10.6.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2"
  }
}
